{
  "name": "sting-formula-1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w concept-1",
    "dev:concept-2": "npm run dev -w concept-2",
    "dev:concept-3": "npm run dev -w concept-3",
    "dev:concept-4": "npm run dev -w concept-4",
    "dev:home": "npm run dev -w home",
    "shots": "node scripts/screenshots.mjs",
    "build": "node scripts/assemble.mjs",
    "preview": "vite preview --config vite.preview.config.ts --host --port 4173",
    "sim": "npm run sim -w concept-1",
    "human": "npm run human -w concept-1",
    "perf:concept-3": "npm run perf -w concept-3 --",
    "perf:concept-4": "npm run perf -w concept-4 --"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "vite": "^8.3.1"
  }
}
